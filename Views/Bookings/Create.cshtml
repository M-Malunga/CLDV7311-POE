@model ST10296771_CLDV7311_POE.Models.Booking

<h2>Create Booking</h2>

<form asp-action="Create">

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group">
        <label>Select Event</label>
        <select asp-for="EventId" asp-items="ViewBag.EventId" class="form-control">
            <option value="">-- Select Event --</option>
        </select>
    </div>

    <div class="form-group">
        <label>Select Venue</label>
        <select asp-for="VenueId" asp-items="ViewBag.VenueId" class="form-control">
            <option value="">-- Select Venue --</option>
        </select>
    </div>

    <div class="form-group">
        <label>Select User</label>
        <select asp-for="CreatedBy" asp-items="ViewBag.UserId" class="form-control">
            <option value="">-- Select User --</option>
        </select>
    </div>

    <br />

    <button type="submit" class="btn btn-primary">Create Booking</button>

</form>
@section Scripts {
    <script>
        $(document).ready(function() {
            $('#VenueId, #BookingDate').on('change', function() {
                var venueId = $('#VenueId').val();
                var bookingDate = $('#BookingDate').val();

                if (venueId && bookingDate) {
                    $.ajax({
                        url: '@Url.Action("CheckAvailability", "Bookings")',
                        type: 'GET',
                        data: { venueId: venueId, bookingDate: bookingDate },
                        success: function(response) {
                            if (!response.isAvailable) {
                                $('#venueAvailabilityWarning').remove();
                                $('#VenueId').after('<div id="venueAvailabilityWarning" class="text-danger">This venue is already booked on the selected date!</div>');
                                $('button[type="submit"]').prop('disabled', true);
                            } else {
                                $('#venueAvailabilityWarning').remove();
                                $('button[type="submit"]').prop('disabled', false);
                            }
                        }
                    });
                }
            });
        });
    </script>
}

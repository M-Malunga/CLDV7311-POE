<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>EventEase Venue Booking</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">EventEase</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <!-- Dashboard -->
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house"></i> Dashboard
                        </a>
                    </li>

                    <!-- Venues -->
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Venues" asp-action="Index">
                            <i class="bi bi-building"></i> Venues
                        </a>
                    </li>

                    <!-- Events -->
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Events" asp-action="Index">
                            <i class="bi bi-calendar-event"></i> Events
                        </a>
                    </li>

                    @if (Context.Session.GetString("UserRole") == "Employee" || Context.Session.GetString("UserRole") == "Admin")
                    {
                        <!-- Add Venue (Employee/Admin) -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Venues" asp-action="Create">
                                <i class="bi bi-plus-circle"></i> Add Venue
                                </a>
                            </li>
                        }

                        <!-- Add Event (Employee/Admin) -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Events" asp-action="Create">
                                <i class="bi bi-plus-circle"></i> Add Event
                            </a>
                        </li>
                    }

                    <!-- ============================================ -->
                    <!-- BOOKINGS DROPDOWN (Employee/Admin)           -->
                    <!-- ============================================ -->
                    @if (Context.Session.GetString("UserRole") == "Employee" || Context.Session.GetString("UserRole") == "Admin")
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="bookingsDropdown" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-calendar-check"></i> Bookings
                            </a>
                            <ul class="dropdown-menu">
                                <!-- Standard View -->
                                <li>
                                    <a class="dropdown-item" asp-controller="Bookings" asp-action="Index">
                                        <i class="bi bi-list"></i> Standard View
                                    </a>
                                </li>
                                <!-- Advanced Search -->
                                <li>
                                    <a class="dropdown-item" asp-controller="BookingManagement" asp-action="AdvancedSearchView">
                                        <i class="bi bi-funnel"></i> Advanced Search
                                    </a>
                                </li>
                                <!-- New Session / Create Booking -->
                                <li>
                                    <a class="dropdown-item" asp-controller="Bookings" asp-action="Create">
                                        <i class="bi bi-plus-circle"></i> New Session
                                    </a>
                                </li>
                                <!-- Booking Requests Management -->
                                <li>
                                    <a class="dropdown-item" asp-controller="BookingRequests" asp-action="Index">
                                        <i class="bi bi-envelope"></i> Manage Requests
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }

                    <!-- ============================================ -->
                    <!-- MY REQUESTS (Customer only)                  -->
                    <!-- ============================================ -->
                    @if (Context.Session.GetString("UserRole") == "Customer")
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="BookingRequests" asp-action="Index">
                                <i class="bi bi-envelope"></i> My Requests
                            </a>
                        </li>
                    }

                    <!-- ============================================ -->
                    <!-- ADMIN DROPDOWN                               -->
                    <!-- ============================================ -->
                    @if (Context.Session.GetString("UserRole") == "Admin")
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-shield-lock"></i> Admin
                            </a>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item" asp-controller="Admin" asp-action="ManageCustomers">
                                        <i class="bi bi-people"></i> Manage Customers
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Admin" asp-action="ManageEmployees">
                                        <i class="bi bi-person-badge"></i> Manage Employees
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="BookingManagement" asp-action="AdvancedSearchView">
                                        <i class="bi bi-funnel"></i> Advanced Search
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }

                    <!-- ============================================ -->
                    <!-- MANAGE REQUESTS (Employee/Admin)             -->
                    <!-- ============================================ -->
                    @if (Context.Session.GetString("UserRole") == "Employee" || Context.Session.GetString("UserRole") == "Admin")
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="BookingRequests" asp-action="Index">
                                <i class="bi bi-envelope"></i> Manage Requests
                            </a>
                        </li>
                    }
                </ul>

                <!-- ============================================ -->
                <!-- USER INFO & LOGOUT                            -->
                <!-- ============================================ -->
                <ul class="navbar-nav">
                    @if (Context.Session.GetString("UserRole") != null)
                    {
                        <li class="nav-item">
                            <span class="navbar-text text-white me-2">
                                <i class="bi bi-person-circle"></i> 
                                @Context.Session.GetString("UserName")
                                <span class="badge bg-secondary ms-1">@Context.Session.GetString("UserRole")</span>
                            </span>
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="form-inline">
                                <button type="submit" class="btn btn-outline-light btn-sm">
                                    <i class="bi bi-box-arrow-right"></i> Logout
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right"></i> Login
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Register">
                                <i class="bi bi-person-plus"></i> Register
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </div>

    <footer class="border-top footer text-muted mt-5">
        <div class="container">
            &copy; 2026 - EventEase Venue Booking System
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
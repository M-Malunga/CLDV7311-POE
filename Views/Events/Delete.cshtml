@model ST10296771_CLDV7311_POE.Models.Event

@{
    ViewData["Title"] = "Delete Event";
}

<h2>Delete Event</h2>

<div class="alert alert-warning">
    <h3>Are you sure you want to delete this event?</h3>
    <p>This action cannot be undone.</p>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="row">
    <div class="col-md-4">
        @if (!string.IsNullOrEmpty(Model.ImageFileName))
        {
            <img src="@Model.ImageUrl" alt="@Model.EventName" class="img-fluid rounded" style="max-height: 200px;">
        }
        else
        {
            <img src="/images/default-event.jpg" alt="Default Event" class="img-fluid rounded" style="max-height: 200px;">
        }
    </div>
    <div class="col-md-8">
        <dl class="row">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.EventName)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.EventName)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.EventDate)
            </dt>
            <dd class="col-sm-9">
                @Model.EventDate.ToString("yyyy-MM-dd")
            </dd>

            <dt class="col-sm-3">
                Venue
            </dt>
            <dd class="col-sm-9">
                @(Model.Venue?.VenueName ?? "No venue assigned")
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.ExpectedAttendees)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.ExpectedAttendees)
            </dd>
        </dl>
    </div>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="EventId" />
    <div class="form-group mt-3">
        <input type="submit" value="Delete Permanently" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>
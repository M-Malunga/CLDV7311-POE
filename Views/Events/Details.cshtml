@model ST10296771_CLDV7311_POE.Models.Event

@{
    ViewData["Title"] = "Event Details";
}

<h2>Event Details</h2>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.EventName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.EventName)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.EventDate)
        </dt>
        <dd class="col-sm-10">
            @Model.EventDate.ToShortDateString()
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>

        <dt class="col-sm-2">
            Venue
        </dt>
        <dd class="col-sm-10">
            @(Model.Venue?.VenueName ?? "No venue assigned")
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ExpectedAttendees)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ExpectedAttendees)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.OrganizerName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.OrganizerName)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.OrganizerContact)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.OrganizerContact)
        </dd>
    </dl>
</div>

<div>
    @if (User.IsInRole("Employee") || User.IsInRole("Admin"))
    {
        <a asp-action="Edit" asp-route-id="@Model?.EventId" class="btn btn-primary">Edit</a>
        <a asp-action="Delete" asp-route-id="@Model?.EventId" class="btn btn-danger">Delete</a>
    }
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
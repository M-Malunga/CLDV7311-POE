@model ST10296771_CLDV7311_POE.Models.Event

@{
    ViewData["Title"] = "Event Details";
}

<h2>Event Details</h2>

<div class="row">
    <div class="col-md-6">
        @if (!string.IsNullOrEmpty(Model.ImageFileName))
        {
            <img src="@Model.ImageUrl" alt="@Model.EventName" class="img-fluid rounded shadow-sm" style="max-height: 400px; width: 100%; object-fit: cover;">
        }
        else
        {
            <img src="/images/default-event.jpg" alt="Default Event" class="img-fluid rounded shadow-sm" style="max-height: 400px; width: 100%; object-fit: cover;">
        }
    </div>
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.EventName)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.EventName)
            </dd>

            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.EventDate)
            </dt>
            <dd class="col-sm-8">
                @Model.EventDate.ToString("dddd, MMMM dd, yyyy")
            </dd>

            <dt class="col-sm-4">
                Venue
            </dt>
            <dd class="col-sm-8">
                @if (Model.Venue != null)
                {
                    <a asp-controller="Venues" asp-action="Details" asp-route-id="@Model.VenueId">
                        @Model.Venue.VenueName
                    </a>
                    <br />
                    <small class="text-muted">📍 @Model.Venue.Location | Capacity: @Model.Venue.Capacity</small>
                }
                else
                {
                    <span class="text-muted">No venue assigned</span>
                }
            </dd>

            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.ExpectedAttendees)
            </dt>
            <dd class="col-sm-8">
                @Model.ExpectedAttendees.ToString("N0")
            </dd>

            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.OrganizerName)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.OrganizerName)
            </dd>

            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.OrganizerContact)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.OrganizerContact)
            </dd>
        </dl>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Description))
{
    <div class="row mt-3">
        <div class="col-12">
            <h4>Description</h4>
            <hr />
            <p>@Model.Description</p>
        </div>
    </div>
}

<div class="mt-3">
    @if (User.IsInRole("Employee") || User.IsInRole("Admin"))
    {
        <a asp-action="Edit" asp-route-id="@Model?.EventId" class="btn btn-primary">Edit</a>
        <a asp-action="Delete" asp-route-id="@Model?.EventId" class="btn btn-danger">Delete</a>
    }
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
@model ST10296771_CLDV7311_POE.Models.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="text-center mb-0">Create New Account</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- Role Selection -->
                        <div class="form-group mb-4">
                            <label asp-for="Role" class="control-label fw-bold"></label>
                            <select asp-for="Role" class="form-select form-select-lg" id="RoleSelect" required>
                                <option value="">-- Select Account Type --</option>
                                <option value="Customer">👤 Customer - Book events and make requests</option>
                                <option value="Employee">👔 Employee - Manage venues and events</option>
                                <option value="Admin">👑 Administrator - Full system access</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger"></span>
                            <div id="RoleDescription" class="mt-2"></div>
                        </div>

                        <!-- Personal Information -->
                        <div class="card mb-4">
                            <div class="card-header bg-light">
                                <h5 class="mb-0">Personal Information</h5>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group mb-3">
                                            <label asp-for="FirstName" class="control-label"></label>
                                            <input asp-for="FirstName" class="form-control" />
                                            <span asp-validation-for="FirstName" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group mb-3">
                                            <label asp-for="LastName" class="control-label"></label>
                                            <input asp-for="LastName" class="form-control" />
                                            <span asp-validation-for="LastName" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Account Information -->
                        <div class="card mb-4">
                            <div class="card-header bg-light">
                                <h5 class="mb-0">Account Information</h5>
                            </div>
                            <div class="card-body">
                                <div class="form-group mb-3">
                                    <label asp-for="Username" class="control-label"></label>
                                    <input asp-for="Username" class="form-control" />
                                    <span asp-validation-for="Username" class="text-danger"></span>
                                    <small class="text-muted">Choose a unique username (3-50 characters)</small>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="Email" class="control-label"></label>
                                    <input asp-for="Email" class="form-control" type="email" />
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                    <small class="text-muted">We'll never share your email with anyone else</small>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group mb-3">
                                            <label asp-for="Password" class="control-label"></label>
                                            <input asp-for="Password" class="form-control" type="password" />
                                            <span asp-validation-for="Password" class="text-danger"></span>
                                            <small class="text-muted">Minimum 6 characters</small>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group mb-3">
                                            <label asp-for="ConfirmPassword" class="control-label"></label>
                                            <input asp-for="ConfirmPassword" class="form-control" type="password" />
                                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Role Benefits Card -->
                        <div class="alert alert-info" id="RoleBenefits" style="display: none;">
                            <strong>✨ Benefits of this role:</strong>
                            <ul class="mb-0 mt-2" id="BenefitsList">
                                <li>Loading...</li>
                            </ul>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-person-plus"></i> Register
                            </button>
                            <a asp-action="Login" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Back to Login
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function() {
            const roleBenefits = {
                'Customer': [
                    '✓ Browse and search for venues',
                    '✓ View upcoming events',
                    '✓ Submit booking requests',
                    '✓ Track your booking status',
                    '✓ View event details and venue information'
                ],
                'Employee': [
                    '✓ All Customer features',
                    '✓ Create, edit, and delete venues',
                    '✓ Create, edit, and delete events',
                    '✓ Manage booking requests',
                    '✓ View all customer bookings',
                    '✓ Access booking management dashboard'
                ],
                'Admin': [
                    '✓ All Employee features',
                    '✓ Full system administration',
                    '✓ Manage user accounts',
                    '✓ Access all system settings',
                    '✓ View system analytics and reports',
                    '✓ Complete database management access'
                ]
            };

            $('#RoleSelect').change(function() {
                var role = $(this).val();
                var description = '';
                var benefits = [];

                switch(role) {
                    case 'Customer':
                        description = '<div class="alert alert-success">🎉 <strong>Customer Account:</strong> Perfect for event attendees and venue bookers. You can browse venues, book events, and track your requests.</div>';
                        benefits = roleBenefits['Customer'];
                        break;
                    case 'Employee':
                        description = '<div class="alert alert-warning">💼 <strong>Employee Account:</strong> Staff members can manage venues, events, and bookings. Full operational access.</div>';
                        benefits = roleBenefits['Employee'];
                        break;
                    case 'Admin':
                        description = '<div class="alert alert-danger">🔒 <strong>Administrator Account:</strong> Complete system control. Full access to all features and user management.</div>';
                        benefits = roleBenefits['Admin'];
                        break;
                    default:
                        description = '';
                        benefits = [];
                }

                $('#RoleDescription').html(description);

                if (benefits.length > 0) {
                    var benefitsHtml = '';
                    benefits.forEach(function(benefit) {
                        benefitsHtml += '<li>' + benefit + '</li>';
                    });
                    $('#BenefitsList').html(benefitsHtml);
                    $('#RoleBenefits').slideDown();
                } else {
                    $('#RoleBenefits').slideUp();
                }
            });
        });
    </script>
}
@model IEnumerable<ST10296771_CLDV7311_POE.Models.Booking>
@using ST10296771_CLDV7311_POE.Models

@{
    ViewData["Title"] = "Advanced Booking Search";
    var searchModel = ViewBag.CurrentSearch as AdvancedBookingSearchViewModel ?? new AdvancedBookingSearchViewModel();
}

<div class="container-fluid">
    <h2 class="mb-4">
        <i class="bi bi-funnel-fill"></i> Advanced Booking Search
    </h2>

    <!-- Advanced Search Form -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-sliders2"></i> Filter Options
            </h5>
        </div>
        <div class="card-body">
            <form method="get" asp-action="AdvancedSearch" id="advancedSearchForm">
                <div class="row g-3">
                    <!-- Search Term -->
                    <div class="col-md-4">
                        <label class="form-label">Search Term</label>
                        <input type="text" name="SearchTerm" class="form-control"
                               placeholder="Booking ID, Event, Venue, Customer..."
                               value="@searchModel.SearchTerm" />
                    </div>

                    <!-- Event Type -->
                    <div class="col-md-3">
                        <label class="form-label">Event Type</label>
                        <select name="EventTypeId" class="form-select">
                            <option value="">-- All Event Types --</option>
                            @foreach (var type in ViewBag.EventTypes)
                            {
                                <option value="@type.EventTypeId" selected="@(searchModel.EventTypeId == type.EventTypeId)">
                                    @type.CategoryName
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Venue Availability -->
                    <div class="col-md-3">
                        <label class="form-label">Venue Availability</label>
                        <select name="VenueAvailability" class="form-select">
                            <option value="">-- All Venues --</option>
                            <option value="Available" selected="@(searchModel.VenueAvailability == "Available")">✅ Available</option>
                            <option value="Unavailable" selected="@(searchModel.VenueAvailability == "Unavailable")">❌ Unavailable</option>
                        </select>
                    </div>

                    <!-- Status -->
                    <div class="col-md-2">
                        <label class="form-label">Event Status</label>
                        <select name="Status" class="form-select">
                            <option value="">-- All --</option>
                            <option value="Upcoming" selected="@(searchModel.Status == "Upcoming")">📅 Upcoming</option>
                            <option value="Today" selected="@(searchModel.Status == "Today")">⭐ Today</option>
                            <option value="Past" selected="@(searchModel.Status == "Past")">📜 Past</option>
                        </select>
                    </div>

                    <!-- Date Range -->
                    <div class="col-md-3">
                        <label class="form-label">Event Date From</label>
                        <input type="date" name="DateFrom" class="form-control"
                               value="@(searchModel.DateFrom?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Event Date To</label>
                        <input type="date" name="DateTo" class="form-control"
                               value="@(searchModel.DateTo?.ToString("yyyy-MM-dd"))" />
                    </div>

                    <!-- Capacity Range -->
                    <div class="col-md-2">
                        <label class="form-label">Min Capacity</label>
                        <input type="number" name="MinCapacity" class="form-control"
                               placeholder="Min" value="@searchModel.MinCapacity" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Max Capacity</label>
                        <input type="number" name="MaxCapacity" class="form-control"
                               placeholder="Max" value="@searchModel.MaxCapacity" />
                    </div>

                    <!-- Venue Amenities -->
                    <div class="col-md-2">
                        <label class="form-label">Sort By</label>
                        <select name="SortBy" class="form-select">
                            <option value="BookingDate" selected="@(searchModel.SortBy == "BookingDate")">Booking Date</option>
                            <option value="EventDate" selected="@(searchModel.SortBy == "EventDate")">Event Date</option>
                            <option value="EventDateDesc" selected="@(searchModel.SortBy == "EventDateDesc")">Event Date (Newest)</option>
                            <option value="Venue" selected="@(searchModel.SortBy == "Venue")">Venue Name</option>
                            <option value="Capacity" selected="@(searchModel.SortBy == "Capacity")">Expected Attendees</option>
                        </select>
                    </div>
                </div>

                <!-- Advanced Amenities Filters -->
                <div class="row mt-3">
                    <div class="col-md-12">
                        <hr />
                        <label class="form-label fw-bold">Venue Amenities</label>
                    </div>
                    <div class="col-md-2">
                        <div class="form-check">
                            <input type="checkbox" name="IsIndoor" class="form-check-input" value="true"
                                   id="isIndoor" @(searchModel.IsIndoor == true ? "checked" : "") />
                            <label class="form-check-label" for="isIndoor">🏢 Indoor Venue</label>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-check">
                            <input type="checkbox" name="HasParking" class="form-check-input" value="true"
                                   id="hasParking" @(searchModel.HasParking == true ? "checked" : "") />
                            <label class="form-check-label" for="hasParking">🅿️ Parking Available</label>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-check">
                            <input type="checkbox" name="IsWheelchairAccessible" class="form-check-input" value="true"
                                   id="wheelchair" @(searchModel.IsWheelchairAccessible == true ? "checked" : "") />
                            <label class="form-check-label" for="wheelchair">♿ Wheelchair Accessible</label>
                        </div>
                    </div>
                </div>

                <div class="row mt-4">
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-search"></i> Apply Filters
                        </button>
                        <a asp-action="AdvancedSearchView" class="btn btn-secondary">
                            <i class="bi bi-arrow-repeat"></i> Reset Filters
                        </a>
                        <button type="button" id="exportBtn" class="btn btn-success">
                            <i class="bi bi-download"></i> Export Results
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Results Summary -->
    <div class="alert alert-info">
        <strong>Found @ViewBag.TotalCount booking(s)</strong> matching your criteria
    </div>

    <!-- Results Table -->
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Booking ID</th>
                            <th>Event</th>
                            <th>Event Type</th>
                            <th>Event Date</th>
                            <th>Venue</th>
                            <th>Status</th>
                            <th>Capacity</th>
                            <th>Customer</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                var status = item.Event != null && item.Event.EventDate < DateTime.Today ? "Completed" :
                                            (item.Event != null && item.Event.EventDate.Date == DateTime.Today) ? "Today" : "Upcoming";
                                var statusClass = status == "Today" ? "success" : (status == "Upcoming" ? "primary" : "secondary");

                                <tr>
                                    <td><strong>#@item.BookingId</strong></td>
                                    <td>
                                        @if (item.Event != null)
                                        {
                                            <strong>@item.Event.EventName</strong><br />
                                            <small class="text-muted">@item.Event.OrganizerName</small>
                                        }
                                    </td>
                                    <td>
                                        @if (item.Event?.EventType != null)
                                        {
                                            <span class="badge bg-info">
                                                <i class="bi @item.Event.EventType.IconClass"></i>
                                                @item.Event.EventType.CategoryName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not specified</span>
                                        }
                                    </td>
                                    <td>
                                        @(item.Event?.EventDate.ToString("yyyy-MM-dd") ?? "N/A")
                                        @if (status == "Today")
                                        {
                                            <span class="badge bg-success ms-1">Today!</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.Venue != null)
                                        {
                                            <strong>@item.Venue.VenueName</strong><br />
                                            <small class="text-muted">@item.Venue.Location</small>
                                            @if (!item.Venue.IsAvailable)
                                            {
                                                <span class="badge bg-danger">Unavailable</span>
                                            }
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-@statusClass">@status</span>
                                    </td>
                                    <td>
                                        @(item.Event?.ExpectedAttendees.ToString("N0") ?? "N/A")
                                        @if (item.Event?.MaxCapacity.HasValue == true)
                                        {
                                            <br /><small class="text-muted">Max: @item.Event.MaxCapacity</small>
                                        }
                                    </td>
                                    <td>
                                        @(item.User?.Username ?? "N/A")<br />
                                        <small class="text-muted">@(item.User?.Email)</small>
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@item.BookingId" class="btn btn-info btn-sm">
                                            <i class="bi bi-eye"></i> View
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center">
                                    <div class="alert alert-warning m-3">
                                        <i class="bi bi-exclamation-triangle"></i> No bookings found matching your criteria.
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $('#exportBtn').click(function() {
            var formData = $('#advancedSearchForm').serialize();
            window.location.href = '@Url.Action("ExportFilteredResults", "BookingManagement")?' + formData;
        });
    </script>
}
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to Event Management System</h1>
    <p>Manage your venues, events, and bookings efficiently.</p>
</div>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger">
        <strong>Error:</strong> @ViewBag.ErrorMessage
    </div>
}

<!-- Debug Information - Remove in production -->
@if (User.IsInRole("Admin"))
{
    <div class="alert alert-info">
        <strong>Debug Info:</strong>
        <p>Venues in database: @ViewBag.VenueCount</p>
        <p>Events in database: @ViewBag.EventCount</p>
        <a asp-controller="Venues" asp-action="Index" class="btn btn-sm btn-primary">View Venues</a>
        <a asp-controller="Events" asp-action="Index" class="btn btn-sm btn-primary">View Events</a>
    </div>
}

<!-- Featured Venues Section -->
<section class="mt-5">
    <h2>Featured Venues</h2>
    <div class="row">
        @if (ViewBag.FeaturedVenues != null && ViewBag.FeaturedVenues.Count > 0)
        {
            @foreach (var venue in ViewBag.FeaturedVenues)
            {
                <div class="col-md-3 mb-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">@venue.VenueName</h5>
                            <p class="card-text">
                                <strong>Location:</strong> @venue.Location<br />
                                <strong>Capacity:</strong> @venue.Capacity<br />
                                <strong>Contact:</strong> @(string.IsNullOrEmpty(venue.ContactPhone) ? "Not provided" : venue.ContactPhone)
                            </p>
                            <a asp-controller="Venues" asp-action="Details" asp-route-id="@venue.VenueId" class="btn btn-primary btn-sm">View Details</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-warning">
                    No venues available.
                    @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
                    {
                        <a asp-controller="Venues" asp-action="Create" class="alert-link">Click here to add a venue</a>
                    }
                </div>
            </div>
        }
    </div>
</section>

<!-- Upcoming Events Section -->
<section class="mt-5">
    <h2>Upcoming Events</h2>
    <div class="row">
        @if (ViewBag.UpcomingEvents != null && ViewBag.UpcomingEvents.Count > 0)
        {
            @foreach (var eventItem in ViewBag.UpcomingEvents)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">@eventItem.EventName</h5>
                            <p class="card-text">
                                <strong>Date:</strong> @eventItem.EventDate.ToString("yyyy-MM-dd")<br />
                                <strong>Venue:</strong> @eventItem.VenueName<br />
                                @if (!string.IsNullOrEmpty(eventItem.Description))
                                {
                                    @(eventItem.Description.Length > 100 ? eventItem.Description.Substring(0, 100) + "..." : eventItem.Description)
                                }
                            </p>
                            <a asp-controller="Events" asp-action="Details" asp-route-id="@eventItem.EventId" class="btn btn-primary btn-sm">View Event</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-warning">
                    No upcoming events scheduled.
                    @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
                    {
                        <a asp-controller="Events" asp-action="Create" class="alert-link">Click here to create an event</a>
                    }
                </div>
            </div>
        }
    </div>
</section>
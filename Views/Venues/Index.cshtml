@model IEnumerable<ST10296771_CLDV7311_POE.Models.Venue>

@{
    ViewData["Title"] = "Venues";
}

<h2>Venues</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (User.IsInRole("Employee") || User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Create New Venue</a>
    </p>
}

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                @if (!string.IsNullOrEmpty(item.ImageFileName))
                {
                    <img src="@item.ImageUrl" class="card-img-top" alt="@item.VenueName"
                         style="height: 200px; object-fit: cover;"
                         onerror="this.onerror=null; this.src='/images/default-venue.jpg';">
                }
                else
                {
                    <img src="/images/default-venue.jpg" class="card-img-top" alt="Default Venue"
                         style="height: 200px; object-fit: cover;">
                }
                <div class="card-body">
                    <h5 class="card-title">@item.VenueName</h5>
                    <p class="card-text">
                        <strong>Location:</strong> @item.Location<br />
                        <strong>Capacity:</strong> @item.Capacity<br />
                        <strong>Contact:</strong> @item.ContactPhone
                    </p>
                </div>
                <div class="card-footer bg-transparent">
                    <a asp-action="Details" asp-route-id="@item.VenueId" class="btn btn-info btn-sm">Details</a>
                    @if (User.IsInRole("Employee") || User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.VenueId" class="btn btn-warning btn-sm">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.VenueId" class="btn btn-danger btn-sm">Delete</a>
                    }
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No venues found.
        @if (User.IsInRole("Employee") || User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="alert-link">Create your first venue</a>
        }
    </div>
}